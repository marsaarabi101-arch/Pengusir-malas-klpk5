<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anti-Malas: Tantangan Tahan Buku</title>
    <style>
        :root {
            /* Tema Awal (Mode Malas) */
            --bg-awal: #2b2d42;
            --teks-awal: #8d99ae;
            /* Tema Fokus (Pink & Putih) */
            --bg-fokus: #fff0f3;
            --pink-utama: #ff4d6d;
            --pink-muda: #ffb3c1;
        }

        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: var(--bg-awal);
            font-family: 'Segoe UI', Arial, sans-serif;
            transition: background-color 0.8s ease;
            overflow: hidden;
            flex-direction: column;
        }

        .container {
            text-align: center;
            padding: 40px;
            border-radius: 25px;
            background: rgba(255, 255, 255, 0.05);
            border: 3px dashed var(--teks-awal);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            max-width: 400px;
            width: 85%;
            transition: all 0.5s ease;
            z-index: 10;
        }

        /* Perubahan Gaya saat Mode Pink-Putih Aktif */
        body.pink-mode {
            background-color: var(--bg-fokus);
        }

        .pink-mode .container {
            background: #ffffff;
            border: 4px solid var(--pink-utama);
            box-shadow: 0 15px 35px rgba(255, 77, 109, 0.2);
        }

        h1 {
            color: #ffffff;
            margin-top: 0;
            transition: color 0.5s;
        }
        .pink-mode h1 { color: var(--pink-utama); }

        p {
            color: var(--teks-awal);
            font-size: 1.1rem;
            margin-bottom: 30px;
            transition: color 0.5s;
        }
        .pink-mode p { color: #4a4a4a; }

        /* Elemen Gambar Buku */
        .buku-container {
            margin: 20px 0;
        }

        #buku {
            font-size: 100px;
            cursor: pointer;
            user-select: none;
            display: inline-block;
            transition: transform 0.1s;
            filter: grayscale(100%);
            /* Animasi mengapung pelan saat malas */
            animation: float 3s ease-in-out infinite;
        }

        #buku.ditekan {
            filter: grayscale(0%);
            animation: pulse 0.4s infinite alternate;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        @keyframes pulse {
            0% { transform: scale(0.95); }
            100% { transform: scale(0.85); }
        }

        /* Timer Skor */
        #timer {
            font-size: 3.5rem;
            font-weight: bold;
            color: #ffffff;
            margin-top: 20px;
            transition: color 0.5s;
        }
        .pink-mode #timer { color: var(--pink-utama); }

        /* Stiker Unik Bergerak */
        .stiker {
            position: absolute;
            font-size: 45px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .pink-mode .stiker {
            opacity: 1;
        }

        @keyframes goyang {
            0%, 100% { transform: rotate(0deg) translateY(0); }
            50% { transform: rotate(15deg) translateY(-10px); }
        }
    </style>
</head>
<body>

    <!-- Stiker Unik Latar Belakang -->
    <div class="stiker" style="top: 15%; left: 10%; animation: goyang 3s infinite;">🚀</div>
    <div class="stiker" style="top: 20%; right: 12%; animation: goyang 4s infinite 0.5s;">✨</div>
    <div class="stiker" style="bottom: 20%; left: 15%; animation: goyang 2.5s infinite 1s;">💡</div>
    <div class="stiker" style="bottom: 15%; right: 10%; animation: goyang 3.5s infinite;">🏆</div>

    <div class="container" id="box">
        <h1 id="judul">Zona Malas</h1>
        <p id="petunjuk">Tekan dan TAHAN LAMA buku di bawah untuk mulai fokus belajar!</p>
        
        <div class="buku-container">
            <!-- Gambar buku menggunakan emoji besar agar praktis -->
            <div id="buku">📖</div>
        </div>

        <div id="timer">0.00s</div>
    </div>

    <script>
        const buku = document.getElementById('buku');
        const timerDisplay = document.getElementById('timer');
        const judul = document.getElementById('judul');
        const petunjuk = document.getElementById('petunjuk');
        const body = document.body;

        let startTime;
        let timerInterval;
        let isPressing = false;

        // Fungsi Suara "Ayo Fokus!" menggunakan Text-to-Speech browser
        function bunyikanPeringatan() {
            const suara = new SpeechSynthesisUtterance("Ayo Fokus!");
            suara.lang = 'id-ID'; // Menggunakan pengaturan bahasa Indonesia
            suara.rate = 1.3;     // Kecepatan bicara tegas
            window.speechSynthesis.speak(suara);
        }

        function mulaiMemicu() {
            if (isPressing) return;
            isPressing = true;
            
            startTime = Date.now();
            buku.classList.add('ditekan');
            judul.innerText = "Sedang Fokus...";
            petunjuk.innerText = "JANGAN DILEPAS! Pertahankan produktivitasmu!";

            timerInterval = setInterval(() => {
                const waktuBerjalan = (Date.now() - startTime) / 1000;
                timerDisplay.innerText = waktuBerjalan.toFixed(2) + "s";

                // Jika berhasil menahan lebih dari 1.5 detik, ubah tema menjadi Pink & Putih
                if (waktuBerjalan > 1.5) {
                    body.classList.add('pink-mode');
                    judul.innerText = "Semangat Pink Mode! 🌸";
                }
            }, 10); // Update setiap 10ms untuk presisi tinggi
        }

        function berhentiMemicu() {
            if (!isPressing) return;
            isPressing = false;
            
            clearInterval(timerInterval);
            buku.classList.remove('ditekan');
            
            // Keluarkan suara instruksi seketika saat dilepas
            bunyikanPeringatan();
            
            // Tampilkan total durasi bertahan
            const totalWaktu = timerDisplay.innerText;
            alert("Yah dilepas! Kamu hanya bertahan selama " + totalWaktu + ".\nYuk, coba lagi dan lawan rasa malasmu!");
            
            // Reset Tampilan ke posisi awal
            timerDisplay.innerText = "0.00s";
            body.classList.remove('pink-mode');
            judul.innerText = "Zona Malas";
            petunjuk.innerText = "Tekan dan TAHAN LAMA buku di bawah untuk mulai fokus belajar!";
        }

        /* --- Event Listener untuk Komputer (Mouse) --- */
        buku.addEventListener('mousedown', mulaiMemicu);
        // window digunakan agar tetap mendeteksi lepas klik meskipun kursor tergeser keluar dari area gambar buku
        window.addEventListener('mouseup', berhentiMemicu); 

        /* --- Event Listener untuk HP (Layar Sentuh) --- */
        buku.addEventListener('touchstart', (e) => {
            e.preventDefault(); // Mencegah double-click otomatis di HP
            mulaiMemicu();
        });
        window.addEventListener('touchend', berhentiMemicu);
    </script>
</body>
</html>
